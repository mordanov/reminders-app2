upstream reminders_api {
    server backend:8000;
    keepalive 16;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    auth_basic "Reminders";
    auth_basic_user_file /etc/nginx/auth/.htpasswd;

    location = /logout {
        auth_basic off;
        add_header 'WWW-Authenticate' 'Basic realm="Reminders"' always;
        add_header 'Content-Type' 'text/html; charset=utf-8' always;
        return 401 '<!DOCTYPE html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>&#1042;&#1099;&#1093;&#1086;&#1076;</title><style>body{font:16px system-ui,sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;margin:0;background:#f8f1e5;color:#333}h1{margin:0 0 12px;font-size:1.5rem}p{margin:0 0 20px;color:#666}a{display:inline-block;padding:10px 22px;background:#84602b;color:#fff;border-radius:6px;text-decoration:none;font-size:1rem}a:hover{background:#6b4e23}</style></head><body><h1>&#1042;&#1099; &#1074;&#1099;&#1096;&#1083;&#1080;</h1><p>&#1053;&#1072;&#1078;&#1084;&#1080;&#1090;&#1077; &#171;&#1054;&#1090;&#1084;&#1077;&#1085;&#1072;&#187;, &#1077;&#1089;&#1083;&#1080; &#1089;&#1085;&#1086;&#1074;&#1072; &#1087;&#1086;&#1103;&#1074;&#1080;&#1083;&#1089;&#1103; &#1079;&#1072;&#1087;&#1088;&#1086;&#1089; &#1074;&#1093;&#1086;&#1076;&#1072;.</p><a href="/">&#1042;&#1086;&#1081;&#1090;&#1080; &#1089;&#1085;&#1086;&#1074;&#1072;</a></body></html>';
    }

    location = /openapi.json {
        auth_basic off;
        proxy_pass http://reminders_api/openapi.json;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/events {
        proxy_pass http://reminders_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Authenticated-User $remote_user;
        proxy_set_header X-Internal-Secret "${INTERNAL_AUTH_SECRET}";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering no;
    }

    location /api/ {
        proxy_pass http://reminders_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Authenticated-User $remote_user;
        proxy_set_header X-Internal-Secret "${INTERNAL_AUTH_SECRET}";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js|png|jpg|jpeg|gif|svg|ico|webp|avif|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
